@model List<ProductListItemViewModel>
@{
    ViewData["Title"] = "Начало";
}

<section class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">Свежи цветя - до вратата ви</h1>
    <p class="lead">Изберете букет, посочете дата и адрес, а ние ще се погрижим за останалото.</p>
    <a class="btn btn-danger btn-lg" asp-controller="Products" asp-action="Index">Разгледайте каталога</a>
</section>

<h2 class="h4 mb-3">Най-нови продукти</h2>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
    @foreach (var product in Model)
    {
        <div class="col"><partial name="_ProductCard" model="product" /></div>
    }
</div>
