@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Количка";
}

<h1 class="h3 mb-3">Вашата количка</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Количката е празна. Функционалността ще бъде реализирана в следващия етап.</div>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Продукт</th><th>Цена</th><th>Брой</th><th>Общо</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("0.00") &euro;</td>
                    <td>@item.Quantity</td>
                    <td>@item.LineTotal.ToString("0.00") &euro;</td>
                </tr>
            }
        </tbody>
    </table>
}
