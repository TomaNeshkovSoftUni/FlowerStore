@{
    ViewData["Title"] = "Администрация";
}

<h1 class="h3 mb-4">Административен панел</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm"><div class="card-body">
            <h5 class="card-title">Продукти</h5>
            <p class="display-6">@ViewData["ProductsCount"]</p>
            <p class="text-muted small mb-0">Управление на продуктите - Етап 3.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm"><div class="card-body">
            <h5 class="card-title">Категории</h5>
            <p class="text-muted small mb-0">Управление на категориите - Етап 3.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm"><div class="card-body">
            <h5 class="card-title">Поръчки</h5>
            <p class="text-muted small mb-0">Обработка на поръчките - Етап 3.</p>
        </div></div>
    </div>
</div>
